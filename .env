# MongoDB credentials
MONGO_ROOT_USER=root
MONGO_ROOT_PASS=123456
MONGO_DB=create-db

# MongoDB network access
MONGO_HOST=mongo
MONGO_PORT=27017

# Full MongoDB URI for Go service
MONGO_URI=mongodb://root:123456@mongo:27017/create-db?authSource=admin

# Collection used by the microservice
COLLECTION_NAME=personas

# Microservice port
PORT=8080
